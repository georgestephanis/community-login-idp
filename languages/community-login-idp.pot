msgid "Workspace ID"
msgstr ""

#: community-login-idp.php:1455
msgid "Optional. If set, only members of this Slack workspace may sign in."
msgstr ""

#: community-login-idp.php:1461
msgid "Server ID"
msgstr ""

#: community-login-idp.php:1465
msgid "Optional but strongly recommended. If set, only members of this Discord server may sign in. Leave it empty and any Discord account in the world can register."
msgstr ""

#: community-login-idp.php:1467
msgid "Turn on Developer Mode in Discord, then right-click the server and choose Copy Server ID. Setting this adds the “guilds” permission to the consent screen people see."
msgstr ""

#: community-login-idp.php:1473
msgid "Redirect URL"
msgstr ""

#: community-login-idp.php:1475
msgid "Add this exact URL to the provider app’s allowed redirect URLs."
msgstr ""

